# ========================================================
# OmniAgent Environment Configuration Template
# ========================================================

# Default LLM Provider: 'groq', 'openai', or 'mock'
DEFAULT_LLM_PROVIDER=groq

# Groq Cloud API Key (Get free key at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini

# Web Search API Key (Optional - Falls back to DuckDuckGo if blank)
TAVILY_API_KEY=your_tavily_api_key_here

# Aviationstack API Key (Optional - For real-time flight tracking)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Database URL (Optional)
DATABASE_URL=postgresql://user:password@localhost:5432/omniagent

# Runtime Server Settings
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501
